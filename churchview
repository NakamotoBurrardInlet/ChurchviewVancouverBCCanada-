        { name: "Mount Pleasant Baptist", lat: 49.2635, lng: -123.0955, address: "Vancouver", type: "Baptist", time: "Sun 11:00 AM" }
    ];

    const listContainer = document.getElementById('church-list');

    churches.forEach((church) => {
        const marker = L.marker([church.lat, church.lng]).addTo(map);
        
        const popupContent = `
            <div class="popup-header">${church.name}</div>
            <div style="font-size: 0.9rem;">
                <b>Type:</b> ${church.type}<br>
                <b>Time:</b> ${church.time}<br>
                <b>Address:</b> ${church.address}
            </div>
        `;
        
        marker.bindPopup(popupContent);

        const li = document.createElement('li');
        li.className = 'church-item';
        li.innerHTML = `<strong>${church.name}</strong><br><small>${church.address}</small>`;
        li.onclick = () => {
            map.setView([church.lat, church.lng], 16);
            marker.openPopup();
        };
        listContainer.appendChild(li);
    });

    document.getElementById('search').addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('.church-item').forEach(item => {
            item.style.display = item.innerText.toLowerCase().includes(val) ? 'block' : 'none';
        });
    });
</script>
</body>
</html>
